{
  "priority": 2,
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/services/manifest/",
    "bodyPatterns": [{ "matchesJsonPath": "$[?(@.consPincode == 999999)]" }]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "transformers": ["response-template"],
    "jsonBody": {
      "status": "Success",
      "successResponse": [],
      "errorResponse": [
        {
          "orderNumber": "{{jsonPath request.body '$[0].orderNumber'}}",
          "customerCode": "UEBCUS0008",
          "status": "Failed",
          "message": "Consignee Pincode 999999 is not serviceable"
        }
      ]
    }
  }
}
