# Fully offline configuration: WireMock stands in for UrbaneBolt, so `docker compose up` needs no
# credentials and no internet. CI copies this over .env; a human can too.
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=false

API_KEY=
DEBUG_COURIER_ERRORS=false
REQUEST_BODY_LIMIT=4mb
SHUTDOWN_TIMEOUT_MS=10000

BULK_MAX_ORDERS=100
BULK_WORKER_CONCURRENCY=5
BULK_JOB_ATTEMPTS=3
BULK_BACKOFF_MS=1000

TRACKING_TTL_SECONDS=0
WORKER_INLINE=false

URBANEBOLT_ENABLED=true
URBANEBOLT_BASE_URL=http://wiremock:8080
URBANEBOLT_USERNAME=offline
URBANEBOLT_PASSWORD=offline
URBANEBOLT_CUSTOMER_CODE=UEBCUS0008
URBANEBOLT_TIMEOUT_MS=15000
URBANEBOLT_RETRY_ATTEMPTS=3
URBANEBOLT_RETRY_BACKOFF_MS=500
URBANEBOLT_MAX_BATCH_SIZE=15

MOCK_ENABLED=true
MOCK_LATENCY_MS=0
MOCK_FAILURE_RATE=0
