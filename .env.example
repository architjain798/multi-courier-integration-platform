NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true

# Leave unset to disable the API key guard entirely.
API_KEY=
# Surfaces raw courier error text in responses. Never enable in production.
DEBUG_COURIER_ERRORS=false
# Bulk submits 100 orders in one body, so the parser limit has to clear that with room to spare.
REQUEST_BODY_LIMIT=4mb
# How long a SIGTERM waits for in-flight work before the process exits anyway.
SHUTDOWN_TIMEOUT_MS=10000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/courier
REDIS_URL=redis://localhost:6379

BULK_MAX_ORDERS=100
BULK_WORKER_CONCURRENCY=5
BULK_JOB_ATTEMPTS=3
BULK_BACKOFF_MS=1000

TRACKING_TTL_SECONDS=60
WORKER_INLINE=false

# UrbaneBolt UAT. These credentials are published in the public API documentation.
# Point the base URL at http://localhost:8080 to run against the WireMock stubs instead.
URBANEBOLT_ENABLED=true
URBANEBOLT_BASE_URL=https://uat.urbanebolt.in
URBANEBOLT_USERNAME=info@urbanebolt.com
URBANEBOLT_PASSWORD=EKIcygsLVV5RCtPZ
URBANEBOLT_CUSTOMER_CODE=UEBCUS0008
URBANEBOLT_TIMEOUT_MS=15000
URBANEBOLT_RETRY_ATTEMPTS=3
URBANEBOLT_RETRY_BACKOFF_MS=500
URBANEBOLT_MAX_BATCH_SIZE=15

MOCK_ENABLED=true
MOCK_LATENCY_MS=0
MOCK_FAILURE_RATE=0
